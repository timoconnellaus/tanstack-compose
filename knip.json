{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "examples/shared/agent": {
      "entry": ["tests/**/*.test.ts"]
    },
    "examples/start/agent": {
      "entry": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.test.tsx",
        "tests-workerd/**/*.test.ts"
      ],
      "ignoreDependencies": ["cloudflare", "compose"]
    },
    "packages/compose-cloudflare": {
      "entry": ["dev/worker.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/compose-typescript": {
      "entry": ["tests/workerd/worker.ts", "tests/fixtures/base.ts"]
    }
  },
  "ignoreWorkspaces": [
    "examples/react/self-modifying-agent",
    "examples/start/showcase"
  ],
  "ignore": ["spikes/**"]
}
