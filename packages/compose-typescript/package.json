{
  "name": "@tanstack/compose-typescript",
  "version": "0.1.0",
  "description": "Type-check and transpile written plugin source for @tanstack/compose, against the declarations of the stubs it was granted",
  "author": "Tim O'Connell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/compose.git",
    "directory": "packages/compose-typescript"
  },
  "homepage": "https://github.com/TanStack/compose",
  "keywords": [
    "compose",
    "plugin",
    "typescript",
    "type-check",
    "agent"
  ],
  "scripts": {
    "clean": "premove ./dist ./coverage",
    "generate:lib": "node scripts/generate-lib.mjs",
    "test:eslint": "eslint ./src ./tests",
    "test:types": "tsc",
    "test:lib": "vitest && vitest --config vitest.jsdom.config.ts && vitest --config vitest.workerd.config.ts",
    "test:lib:dev": "vitest --watch",
    "test:build": "publint --strict",
    "build": "tsdown --tsconfig tsconfig.build.json"
  },
  "bin": {
    "compose-declarations": "./dist/cli.js"
  },
  "type": "module",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./generate": {
      "import": "./dist/generate.js",
      "require": "./dist/generate.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tanstack/compose": "workspace:*",
    "typescript": "6.0.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tanstack/compose-example-agent-runtime": "workspace:*",
    "rolldown": "^1.2.6",
    "vite": "^8.0.8"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
