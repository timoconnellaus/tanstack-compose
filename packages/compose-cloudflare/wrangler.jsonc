{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compose-cloudflare-dev",
  "main": "./dev/worker.ts",
  "compatibility_date": "2026-05-01",
  "worker_loaders": [{ "binding": "LOADER" }],
  // Workers AI. There is no local simulation of it — inference always runs on
  // Cloudflare — so the routes that use it need a logged-in account, even under
  // `wrangler dev`. The suite runs against a fake binding and needs neither;
  // see `vitest.config.ts` for how it keeps the real one out of the way.
  "ai": { "binding": "AI" },
}
